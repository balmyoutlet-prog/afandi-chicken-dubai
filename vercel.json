{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "alafandichicken.com",
    "www.alafandichicken.com"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.alafandichicken.com"
        }
      ],
      "destination": "https://alafandichicken.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/affandi.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/analytics/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://affandi-chicken-dubai.suzy-309.chatgpt.site/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://affandi-chicken-dubai.suzy-309.chatgpt.site/admin"
    },
    {
      "source": "/admin.html",
      "destination": "/admin"
    },
    {
      "source": "/admin.js",
      "destination": "https://affandi-chicken-dubai.suzy-309.chatgpt.site/admin.js"
    },
    {
      "source": "/admin.css",
      "destination": "https://affandi-chicken-dubai.suzy-309.chatgpt.site/admin.css"
    },
    {
      "source": "/api/analytics/:action",
      "destination": "/api/admin-analytics?action=:action"
    }
  ]
}
